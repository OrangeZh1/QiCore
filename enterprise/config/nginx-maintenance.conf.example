# Include in every QiCore console/H5/API server block. Keep the existing business proxy.
# This upstream is the stable controller, not Nuxt or the versioned production launcher.
location = /api/v1/public/maintenance {
    proxy_pass http://127.0.0.1:3502;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
    proxy_cache off;
    proxy_intercept_errors off;
    add_header Cache-Control "no-store" always;
}
