{
  "name": "@qicore/api",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env dist/main.js",
    "build": "tsc && node --input-type=module -e \"import {copyFileSync} from 'node:fs'; copyFileSync('src/package.json','dist/package.json')\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file=../../.env node_modules/prisma/build/index.js migrate deploy",
    "test": "node --test test/*.test.mjs",
    "test:unit": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@prisma/client": "6.19.3",
    "ali-oss": "6.23.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "croner": "10.0.1",
    "express": "5.2.1",
    "file-type": "21.3.4",
    "ioredis": "5.7.0",
    "marked": "17.0.6",
    "prisma": "6.19.3",
    "qiniu": "7.15.2",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.7",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "yauzl": "3.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.10.2",
    "@types/semver": "7.7.1",
    "@types/yauzl": "2.10.3",
    "typescript": "5.9.3"
  }
}
