model ScheduledTask {
  enterpriseId String? @db.VarChar(64)
  @@index([enterpriseId,enabled,nextRunAt],map:"ScheduledTask_enterprise_due")
  id String @id @db.VarChar(64)
  name String @db.VarChar(60)
  command String @db.VarChar(64)
  params String @db.VarChar(1000)
  rule String @db.VarChar(100)
  enabled Boolean @default(true)
  remark String @default("") @db.VarChar(200)
  ownerId String @db.VarChar(64)
  version Int @default(1)
  running Boolean @default(false)
  nextRunAt DateTime @db.DateTime(3)
  lastRunAt DateTime? @db.DateTime(3)
  lastFinishedAt DateTime? @db.DateTime(3)
  lastStatus String? @db.VarChar(16)
  lastError String? @db.VarChar(200)
  durationMs Int?
  maxDurationMs Int?
  createdAt DateTime @default(now()) @db.DateTime(3)
  @@index([enabled,nextRunAt])
}
