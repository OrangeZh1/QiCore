// Public payment records retain immutable scope and credential references.
model PaymentRecord {
 providerState Json?
 refunds PaymentRefund[]
 id String @id @db.VarChar(32)
 tenantId String @db.VarChar(64)
 applicationKey String @db.VarChar(64)
 orderId String @db.VarChar(64)
 userId String @db.VarChar(64)
