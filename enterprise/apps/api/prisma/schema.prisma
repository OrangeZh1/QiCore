 payerTotal Int?
 paidAt DateTime? @db.DateTime(3)
 prepayId String? @db.VarChar(128)
 signingHash String? @db.VarChar(64)
 expiresAt DateTime @db.DateTime(3)
 closeRequested Boolean @default(false)
 closeReason String? @db.VarChar(16)
 // One current attempt per order; MySQL permits multiple historical NULL slots.
 currentSlot Int? @default(1)
 sequence Int @default(1)
 previousId String? @unique @db.VarChar(32)
 supersededAt DateTime? @db.DateTime(3)
 leaseToken String? @db.VarChar(36)
 leaseUntil DateTime? @db.DateTime(3)
 nextCheckAt DateTime @default(now()) @db.DateTime(3)
 attempts Int @default(0)
 lastError String? @db.VarChar(64)
 createdAt DateTime @default(now()) @db.DateTime(3)
 @@unique([tenantId,applicationKey,orderId,currentSlot], map: "PaymentRecord_order_key")
 @@unique([tenantId,applicationKey,orderId,sequence], map: "PaymentRecord_sequence_key")
 @@index([nextCheckAt,state], map: "PaymentRecord_recovery_idx")
 @@index([state,nextCheckAt], map: "PaymentRecord_pending_idx")
}
